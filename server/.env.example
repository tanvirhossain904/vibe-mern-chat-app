NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
APP_NAME=Vibe
# "lax" for same-site dev. Set to "none" when frontend and backend are on different domains (cross-site cookies in production).
COOKIE_SAMESITE=lax

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
JWT_SECRET="replace_with_a_long_random_string_at_least_32_chars"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: enable real password-reset emails. Leave blank in dev to log the reset URL to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: enable Redis socket adapter for multi-instance scaling. Leave blank for single-instance.
REDIS_URL=
