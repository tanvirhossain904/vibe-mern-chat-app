{
  "name": "vibe-mern-chat-app",
  "version": "1.0.0",
  "private": true,
  "description": "Run both server and client from the repo root.",
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
